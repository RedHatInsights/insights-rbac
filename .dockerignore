# Ignore everything
**

# Explicitly prune large local build and tool state before Buildah walks the
# context. The broad allowlist below is correct for Docker, but Buildah can
# still traverse excluded trees while resolving negated directory patterns.
.git/
.tox/
.mypy_cache/
htmlcov/
.playwright-mcp/
.claude-chat/
.cursor/
.cves/
review_reports/

# ... except for dependencies and source
!LICENSE
!Pipfile
!Pipfile.lock
!tox.ini
!rbac/
!docs/source/specs/
docs/source/specs/typespec/node_modules/
!scripts/
!deploy/
!tests/
!Makefile
!mypy.ini
!.coveragerc

# keep the test files out of the final image
#**/*test*
**/__pycache__
**/*.log

# remove any static files
rbac/static/**
!rbac/static/README

# Can be removed after this will be fixed https://issues.redhat.com/browse/STONEBLD-3768
!labels.json
